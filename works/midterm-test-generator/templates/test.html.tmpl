<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<title>{{TITLE}}</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
  :root {
    --accent: #2563eb;
    --accent-soft: #dbeafe;
    --ok: #16a34a;
    --text: #0f172a;
    --muted: #64748b;
    --line: #e2e8f0;
    --bg: #ffffff;
  }
  * { box-sizing: border-box; }
  body {
    font-family: -apple-system, BlinkMacSystemFont, "Hiragino Sans", "Yu Gothic", sans-serif;
    color: var(--text);
    background: var(--bg);
    line-height: 1.7;
    max-width: 800px;
    margin: 0 auto;
    padding: 24px 20px 80px;
    font-size: 17px;
  }
  header {
    border-bottom: 2px solid var(--accent);
    padding-bottom: 12px;
    margin-bottom: 20px;
  }
  h1 { font-size: 22px; margin: 0 0 4px; }
  .meta { color: var(--muted); font-size: 13px; }
  .toolbar {
    position: sticky;
    top: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
    padding: 10px 0;
    margin-bottom: 24px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    z-index: 10;
  }
  .toolbar button {
    border: 1px solid var(--accent);
    background: #fff;
    color: var(--accent);
    border-radius: 6px;
    padding: 6px 12px;
    font-size: 14px;
    cursor: pointer;
  }
  .toolbar button:hover { background: var(--accent-soft); }
  .toolbar button.primary { background: var(--accent); color: #fff; }
  .q {
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 14px 18px;
    margin-bottom: 14px;
    page-break-inside: avoid;
  }
  .q-no {
    font-weight: bold;
    color: var(--accent);
    margin-right: 6px;
  }
  .q-type {
    font-size: 11px;
    color: #fff;
    background: var(--muted);
    padding: 2px 7px;
    border-radius: 10px;
    margin-left: 8px;
    vertical-align: middle;
  }
  .q-body { margin-top: 6px; }
  .choices { list-style: none; padding-left: 0; margin: 6px 0 0; }
  .choices li {
    padding: 4px 0 4px 28px;
    position: relative;
  }
  .choices li::before {
    content: attr(data-mark);
    position: absolute;
    left: 0;
    color: var(--muted);
    font-weight: bold;
  }
  .answer {
    margin-top: 10px;
    padding: 8px 12px;
    background: #f0fdf4;
    border-left: 3px solid var(--ok);
    border-radius: 4px;
    display: none;
  }
  .answer.show { display: block; }
  .answer-label { color: var(--ok); font-weight: bold; font-size: 13px; }
  .toggle-btn {
    border: 1px solid var(--line);
    background: #fff;
    border-radius: 4px;
    padding: 3px 10px;
    font-size: 12px;
    color: var(--muted);
    cursor: pointer;
    margin-top: 8px;
  }
  .toggle-btn:hover { color: var(--ok); border-color: var(--ok); }
  .blank {
    display: inline-block;
    min-width: 80px;
    border-bottom: 1.5px solid var(--text);
    padding: 0 4px;
  }
  footer {
    margin-top: 40px;
    color: var(--muted);
    font-size: 12px;
    text-align: center;
  }
  @media print {
    .toolbar, .toggle-btn { display: none !important; }
    body { padding: 0; font-size: 14px; max-width: none; }
    .q { break-inside: avoid; border-color: #999; }
    .answer { background: #fff; border-left-color: #333; }
  }
</style>
</head>
<body>

<header>
  <h1>{{TITLE}}</h1>
  <div class="meta">{{SUBJECT}} / 全 {{TOTAL}} 問 / 生成日: {{GENERATED_AT}}</div>
</header>

<div class="toolbar">
  <button onclick="toggleAll(true)">全ての答えを表示</button>
  <button onclick="toggleAll(false)">全て隠す</button>
  <button class="primary" onclick="window.print()">印刷 / PDF</button>
</div>

<main id="questions">
  <!-- ▼ ここに問題ブロックを {{TOTAL}} 個並べる。サンプルが3種類あるので形式に応じて使い分けてください。 -->

  <!-- 形式: 穴埋め -->
  <div class="q" data-no="1">
    <div><span class="q-no">問1</span>次の文の（　）に当てはまる語を答えなさい。<span class="q-type">穴埋め</span></div>
    <div class="q-body">私は東京の出身です。 → I'm （<span class="blank"></span>） Tokyo.</div>
    <button class="toggle-btn" onclick="toggleAnswer(this)">答えを見る</button>
    <div class="answer"><span class="answer-label">答え:</span> from</div>
  </div>

  <!-- 形式: 一問一答（短答記述） -->
  <div class="q" data-no="2">
    <div><span class="q-no">問2</span>次の単語の意味を日本語で答えなさい。<span class="q-type">一問一答</span></div>
    <div class="q-body">teacher</div>
    <button class="toggle-btn" onclick="toggleAnswer(this)">答えを見る</button>
    <div class="answer"><span class="answer-label">答え:</span> 先生 / 教師</div>
  </div>

  <!-- 形式: 選択式 -->
  <div class="q" data-no="3">
    <div><span class="q-no">問3</span>次の英文の（　）に入る最も適切な語を選びなさい。<span class="q-type">選択</span></div>
    <div class="q-body">She （　） a student.
      <ul class="choices">
        <li data-mark="ア.">am</li>
        <li data-mark="イ.">is</li>
        <li data-mark="ウ.">are</li>
        <li data-mark="エ.">be</li>
      </ul>
    </div>
    <button class="toggle-btn" onclick="toggleAnswer(this)">答えを見る</button>
    <div class="answer"><span class="answer-label">答え:</span> イ. is</div>
  </div>

  <!-- 形式: 正誤判定 -->
  <div class="q" data-no="4">
    <div><span class="q-no">問4</span>次の文が正しければ「○」、誤っていれば「×」を書きなさい。<span class="q-type">正誤</span></div>
    <div class="q-body">"I am from Japan." の否定文は "I am not from Japan." である。</div>
    <button class="toggle-btn" onclick="toggleAnswer(this)">答えを見る</button>
    <div class="answer"><span class="answer-label">答え:</span> ○（be動詞の否定は be動詞の後ろに not を置く）</div>
  </div>

</main>

<footer>{{FOOTER}}</footer>

<script>
  function toggleAnswer(btn) {
    const ans = btn.nextElementSibling;
    ans.classList.toggle('show');
    btn.textContent = ans.classList.contains('show') ? '答えを隠す' : '答えを見る';
  }
  function toggleAll(show) {
    document.querySelectorAll('.answer').forEach(a => a.classList.toggle('show', show));
    document.querySelectorAll('.toggle-btn').forEach(b => {
      b.textContent = show ? '答えを隠す' : '答えを見る';
    });
  }
</script>
</body>
</html>
